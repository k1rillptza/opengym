# Vercel server-side variables. Never prefix these with VITE_ or commit real values.
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-sb_secret-key

# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.

# Optional: Telegram initData is accepted for 24 hours by default.
# TELEGRAM_AUTH_MAX_AGE=86400
